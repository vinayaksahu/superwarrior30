generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER SYSTEM
// ==========================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  BLOCKED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String?
  phone         String?
  avatarUrl     String?
  role              UserRole   @default(STUDENT)
  adminRole         String?    // SUPER_ADMIN, FULL_ACCESS_ADMIN, SUPPORT, VIEWER, FINANCE, MARKETING, CUSTOM_ROLE
  customPermissions Json?      @db.JsonB
  status            UserStatus @default(ACTIVE)
  referralCode      String     @unique
  tokenVersion      Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Referral relationships
  referredBy       ReferralRelationship?  @relation("ReferredBy")
  directReferrals  ReferralRelationship[] @relation("DirectReferrals")
  ancestorNodes    ReferralClosure[]      @relation("AncestorNodes")
  descendantNodes  ReferralClosure[]      @relation("DescendantNodes")

  // Learning
  enrollments    CourseEnrollment[]
  lessonProgress LessonProgress[]

  // Commerce
  orders            Order[]
  couponRedemptions CouponRedemption[]
  earnedCommissions ReferralCommissionRecord[] @relation("UserCommissions")

  // Wallet
  wallet Wallet?

  // Withdrawals
  withdrawals Withdrawal[]

  // Devices & Session Security
  devices UserDevice[]

  // Password resets
  passwordResetTokens PasswordResetToken[]

  // Audit
  auditLogs AuditLog[] @relation("AuditActor")
  deletedCourses Course[] @relation("CourseDeletedBy")
  clearedCommissions ReferralCommissionRecord[] @relation("CommissionsCleared")

  // Live Sessions
  liveSessionAttendances LiveSessionAttendee[]
  hostedLiveSessions     LiveSession[] @relation("LiveSessionHost")

  // Broker Offer & Cashback
  brokerClaims           BrokerOfferClaim[]
  verifiedBrokerClaims   BrokerOfferClaim[] @relation("BrokerClaimsVerified")
  paidBrokerClaims       BrokerOfferClaim[] @relation("BrokerClaimsPaid")

  // Support System
  supportInquiries       SupportInquiry[]

  // Email OTPs
  otps                   EmailOtp[]

  @@index([role])
  @@index([status])
  @@index([referralCode])
  @@map("users")
}

model EmailOtp {
  id          String    @id @default(cuid())
  userId      String?
  email       String
  purpose     String    @default("LOGIN_VERIFICATION")
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  usedAt      DateTime?
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId, purpose])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("email_otps")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash, expiresAt])
  @@map("password_reset_tokens")
}

// ==========================================
// REFERRAL SYSTEM
// ==========================================

model ReferralLevel {
  id                                  String   @id @default(cuid())
  level                               Int      @unique
  commissionRate                      Decimal  @db.Decimal(5, 4) // e.g. 0.1000 = 10%
  isEnabled                           Boolean  @default(true)
  requiresDirectReferralQualification Boolean  @default(false)
  directReferralsRequired             Int      @default(0)
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  @@map("referral_levels")
}

model ReferralRelationship {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  createdAt  DateTime @default(now())

  referrer User @relation("DirectReferrals", fields: [referrerId], references: [id], onDelete: Restrict)
  referred User @relation("ReferredBy", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referral_relationships")
}

model ReferralClosure {
  id           String @id @default(cuid())
  ancestorId   String
  descendantId String
  depth        Int // 1 = direct parent, 2 = grandparent, etc.

  ancestor   User @relation("AncestorNodes", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant User @relation("DescendantNodes", fields: [descendantId], references: [id], onDelete: Cascade)

  @@unique([ancestorId, descendantId])
  @@index([descendantId, depth])
  @@index([ancestorId, depth])
  @@map("referral_closures")
}

// ==========================================
// COURSE SYSTEM
// ==========================================

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonContentType {
  VIDEO
  PDF
  TEXT
}

model Course {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  shortDescription String?
  fullDescription  String?         @db.Text
  thumbnailKey     String?         // R2 key for thumbnail
  thumbnailCdnUrl  String?         // Bunny CDN URL for thumbnail
  price            Decimal         @db.Decimal(12, 2)
  compareAtPrice   Decimal?        @db.Decimal(12, 2)
  status           CourseStatus    @default(DRAFT)
  isFeatured         Boolean         @default(false)
  isReferralEligible Boolean         @default(true)
  difficulty         DifficultyLevel @default(BEGINNER)
  totalDuration    Int             @default(0) // seconds
  deletedAt        DateTime?
  deletedById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  deletedBy   User?           @relation("CourseDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  modules     Module[]
  enrollments CourseEnrollment[]
  orderItems  OrderItem[]
  couponCourses CouponCourse[]
  liveSessions  LiveSession[]

  @@index([status, createdAt])
  @@index([isFeatured])
  @@index([deletedAt])
  @@map("courses")
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  position    Int
  isPublished Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id            String            @id @default(cuid())
  moduleId      String
  title         String
  slug          String
  position      Int
  contentType   LessonContentType @default(VIDEO)
  videoKey      String?           // R2 key for video
  pdfKey        String?           // R2 key for PDF
  bunnyVideoId  String?           // Bunny Stream video GUID
  bunnyCdnUrl   String?           // Bunny CDN URL for PDF/image
  mediaProvider String?           // "R2" | "BUNNY" (null = R2)
  textContent   String?           @db.Text
  durationSec   Int               @default(0)
  isFreePreview Boolean           @default(false)
  isPublished   Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([moduleId, position])
  @@unique([moduleId, slug])
  @@index([moduleId])
  @@map("lessons")
}

// ==========================================
// ENROLLMENT & PROGRESS
// ==========================================

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
  COMPLETED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model CourseEnrollment {
  id                 String           @id @default(cuid())
  userId             String
  courseId           String
  orderId            String?
  status             EnrollmentStatus @default(ACTIVE)
  progressPercentage Decimal          @default(0.00) @db.Decimal(5, 2)
  enrolledAt         DateTime         @default(now())
  expiresAt          DateTime?
  completedAt        DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@map("course_enrollments")
}

model LessonProgress {
  id                  String         @id @default(cuid())
  userId              String
  lessonId            String
  status              ProgressStatus @default(NOT_STARTED)
  watchTimeSeconds    Int            @default(0)
  lastPositionSeconds Int            @default(0)
  completedAt         DateTime?
  updatedAt           DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ==========================================
// ORDER SYSTEM
// ==========================================

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  couponId        String?
  idempotencyKey  String?     @unique
  status          OrderStatus @default(PENDING)
  currency        String      @default("INR") @db.VarChar(3)
  subtotalAmount  Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0.00) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  paymentProvider    String?
  gatewayOrderId     String?     // Razorpay order_xxx — preserved permanently, never overwritten
  paymentId          String?     // External payment ID (razorpay pay_xxx after fulfillment)
  manualPaymentRef   String?     // UTR / Transaction ID / TxHash
  manualPaymentProof Json?       @db.JsonB
  approvedAt         DateTime?
  approvedBy         String?
  paidAt             DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?
  metadata        Json?       @db.JsonB
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon             Coupon?                 @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  enrollments        CourseEnrollment[]
  redemptions        CouponRedemption[]
  commissionSnapshot OrderCommissionSnapshot?
  commissions        ReferralCommissionRecord[]
  brokerClaim        BrokerOfferClaim?

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([orderNumber])
  @@index([gatewayOrderId])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  courseId   String?
  itemTitle  String  // Snapshot of course title at purchase time
  unitPrice  Decimal @db.Decimal(12, 2)
  quantity   Int     @default(1)
  totalPrice Decimal @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([courseId])
  @@map("order_items")
}

// ==========================================
// COUPON SYSTEM
// ==========================================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  discountType      DiscountType
  discountValue     Decimal      @db.Decimal(12, 2)
  minOrderAmount    Decimal      @default(0.00) @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime
  usageLimit        Int?         // Global max redemptions (null = unlimited)
  perUserLimit      Int          @default(1)
  usageCount        Int          @default(0)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]
  courses     CouponCourse[]

  @@index([code, isActive])
  @@index([startDate, endDate])
  @@map("coupons")
}

model CouponCourse {
  id       String @id @default(cuid())
  couponId String
  courseId String

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([couponId, courseId])
  @@map("coupon_courses")
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  userId          String
  orderId         String
  discountApplied Decimal  @db.Decimal(12, 2)
  redeemedAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ==========================================
// COMMISSION SYSTEM
// ==========================================

enum CommissionStatus {
  PENDING
  AVAILABLE
  CANCELLED
  PAID_OUT
  REVERSED
}

model OrderCommissionSnapshot {
  id           String  @id @default(cuid())
  orderId      String  @unique
  baseAmount   Decimal @db.Decimal(12, 2)
  planSnapshot Json    @db.JsonB // Snapshot of referral levels at purchase time
  createdAt    DateTime @default(now())

  order   Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  records ReferralCommissionRecord[]

  @@map("order_commission_snapshots")
}

model ReferralCommissionRecord {
  id               String           @id @default(cuid())
  snapshotId       String
  orderId          String
  beneficiaryId    String
  level            Int
  rateApplied      Decimal          @db.Decimal(5, 4)
  commissionAmount Decimal          @db.Decimal(12, 2)
  status           CommissionStatus @default(PENDING)
  availableAt      DateTime?        // When commission holding period clears and becomes AVAILABLE
  clearedAt        DateTime?        // Timestamp when transitioned to AVAILABLE
  clearedById      String?          // SUPER_ADMIN user ID if manually released
  clearedReason    String?          // Audit note or reason for clearance/release
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  snapshot    OrderCommissionSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  order       Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beneficiary User                    @relation("UserCommissions", fields: [beneficiaryId], references: [id], onDelete: Restrict)
  clearedBy   User?                   @relation("CommissionsCleared", fields: [clearedById], references: [id], onDelete: SetNull)

  @@unique([orderId, beneficiaryId, level])
  @@index([beneficiaryId, status])
  @@index([status, availableAt])
  @@index([status])
  @@index([createdAt])
  @@map("referral_commission_records")
}

// ==========================================
// WALLET SYSTEM
// ==========================================

enum WalletTxType {
  CREDIT_COMMISSION
  DEBIT_WITHDRAWAL
  ADJUSTMENT
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model Wallet {
  id               String  @id @default(cuid())
  userId           String  @unique
  availableBalance Decimal @default(0.00) @db.Decimal(12, 2)
  pendingBalance   Decimal @default(0.00) @db.Decimal(12, 2)
  totalEarned      Decimal @default(0.00) @db.Decimal(12, 2)
  totalWithdrawn   Decimal @default(0.00) @db.Decimal(12, 2)
  version          Int     @default(1) // Optimistic locking
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String         @id @default(cuid())
  walletId      String
  type          WalletTxType
  status        WalletTxStatus @default(COMPLETED)
  amount        Decimal        @db.Decimal(12, 2)
  balanceBefore Decimal        @db.Decimal(12, 2)
  balanceAfter  Decimal        @db.Decimal(12, 2)
  description   String?
  referenceType String?        // e.g. "COMMISSION", "WITHDRAWAL"
  referenceId   String?
  createdAt     DateTime       @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

// ==========================================
// WITHDRAWAL SYSTEM
// ==========================================

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Withdrawal {
  id             String           @id @default(cuid())
  userId         String
  amount         Decimal          @db.Decimal(12, 2)
  paymentMethod  String           // e.g. "bank_transfer", "upi"
  paymentDetails Json             @db.JsonB // e.g. { upiId: "...", bankName: "..." }
  status         WithdrawalStatus @default(PENDING)
  adminNote      String?
  processedAt    DateTime?
  processedBy    String?
  transactionRef String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("withdrawals")
}

// ==========================================
// SITE SETTINGS
// ==========================================

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  type  String @default("string") // string, number, boolean, json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String   // e.g. "COURSE_CREATED", "COUPON_UPDATED", "WITHDRAWAL_APPROVED"
  entityType String   // e.g. "Course", "Coupon", "Withdrawal"
  entityId   String
  oldValues  Json?    @db.JsonB
  newValues  Json?    @db.JsonB
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ==========================================
// SYSTEM PAYMENT METHODS (MANUAL DEPOSITS)
// ==========================================

enum PaymentMethodType {
  UPI
  BANK
  CRYPTO
  GATEWAY
}

model SystemPaymentMethod {
  id           String            @id @default(cuid())
  type         PaymentMethodType
  title        String
  details      Json              @db.JsonB
  instructions String?           @db.Text
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("system_payment_methods")
}

// ==========================================
// USER DEVICES & SESSION SECURITY
// ==========================================

model UserDevice {
  id              String    @id @default(cuid())
  userId          String
  deviceTokenHash String
  deviceName      String?
  browser         String?
  operatingSystem String?
  userAgent       String?   @db.Text
  lastIpAddress   String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  lastLoginAt     DateTime  @default(now())
  isActive        Boolean   @default(true)
  revokedAt       DateTime?
  revokedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceTokenHash])
  @@index([userId])
  @@index([deviceTokenHash])
  @@index([userId, isActive])
  @@map("user_devices")
}

// ==========================================
// LEAD & FUNNEL SYSTEM
// ==========================================

enum LeadStage {
  NEW_LEAD
  QUIZ_COMPLETED
  COURSE_VIEWED
  CHECKOUT_STARTED
  PURCHASED
}

model Lead {
  id              String    @id @default(cuid())
  name            String?
  email           String?
  phone           String?
  whatsapp        String?

  // Quiz answers
  tradingExperience   String?
  targetMarket        String?
  mainChallenge       String?
  lossRange           String?
  learningGoals       String?
  readyForTraining    String?
  quizAnswers         Json?     @db.JsonB

  // Funnel tracking
  stage           LeadStage   @default(NEW_LEAD)
  courseId         String?
  userId          String?
  source          String?

  // UTM Attribution
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?

  // Funnel timestamps
  landingPageAt       DateTime?
  quizStartedAt       DateTime?
  quizCompletedAt     DateTime?
  courseViewedAt       DateTime?
  checkoutStartedAt   DateTime?
  purchaseCompletedAt DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([email])
  @@index([phone])
  @@index([stage])
  @@index([createdAt(sort: Desc)])
  @@index([utmSource, utmCampaign])
  @@map("leads")
}

model Testimonial {
  id          String    @id @default(cuid())
  studentName String
  content     String    @db.Text
  photoUrl    String?
  videoUrl    String?
  rating      Int       @default(5)
  isApproved  Boolean   @default(false)
  isVisible   Boolean   @default(true)
  courseId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isApproved, isVisible])
  @@map("testimonials")
}

model FunnelEvent {
  id          String   @id @default(cuid())
  leadId      String?
  sessionId   String?
  eventType   String
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([leadId])
  @@index([sessionId])
  @@map("funnel_events")
}

// ==========================================
// LIVE SESSIONS & VIDEO MEETINGS
// ==========================================

enum LiveSessionProvider {
  ZOOM
  GOOGLE_MEET
  EMBEDDED_ROOM
  BUNNY_LIVE
  CUSTOM
}

enum LiveSessionStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

model LiveSession {
  id              String              @id @default(cuid())
  title           String
  slug            String              @unique
  description     String?             @db.Text
  courseId        String?
  provider        LiveSessionProvider @default(ZOOM)
  meetingUrl      String?             @db.Text
  meetingId       String?
  passcode        String?
  roomName        String?             // Unique room slug for embedded video call
  scheduledAt     DateTime
  durationMinutes Int                 @default(60)
  status          LiveSessionStatus   @default(UPCOMING)
  recordingUrl    String?             @db.Text
  bunnyVideoId    String?
  isPublished     Boolean             @default(true)
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  course    Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  host      User?                 @relation("LiveSessionHost", fields: [createdById], references: [id], onDelete: SetNull)
  attendees LiveSessionAttendee[]

  @@index([status, scheduledAt])
  @@index([courseId])
  @@index([isPublished])
  @@map("live_sessions")
}

model LiveSessionAttendee {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
  @@map("live_session_attendees")
}

// ==========================================
// BROKER OFFER & CASHBACK SYSTEM
// ==========================================

enum BrokerOfferMode {
  CASHBACK
  INSTANT_DISCOUNT
}

enum BrokerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CashbackStatus {
  NOT_APPLICABLE
  PENDING_VERIFICATION
  AVAILABLE
  CLAIM_REQUESTED
  PAID
  REJECTED
}

model BrokerOfferClaim {
  id                 String                   @id @default(cuid())
  userId             String
  orderId            String                   @unique
  brokerName         String                   @default("Partner Broker")
  brokerMemberId     String
  proofUrl           String?
  mode               BrokerOfferMode          @default(CASHBACK)
  verificationStatus BrokerVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  rejectionReason    String?
  coursePrice        Decimal                  @db.Decimal(12, 2)
  offerPercentage    Decimal                  @default(40.00) @db.Decimal(5, 2)
  calculatedAmount   Decimal                  @db.Decimal(12, 2)
  cashbackStatus     CashbackStatus           @default(PENDING_VERIFICATION)
  payoutDetails      Json?                    @db.JsonB
  claimedAt          DateTime?
  paidAt             DateTime?
  paidById           String?
  payoutTxRef        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("BrokerClaimsVerified", fields: [verifiedById], references: [id], onDelete: SetNull)
  paidBy     User? @relation("BrokerClaimsPaid", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([userId, cashbackStatus])
  @@index([verificationStatus])
  @@index([cashbackStatus])
  @@index([brokerMemberId])
  @@index([createdAt(sort: Desc)])
  @@map("broker_offer_claims")
}

// ==========================================
// MEDIA STORAGE & CDN PROVIDER CONFIGURATION
// ==========================================

enum MediaProviderType {
  BUNNY
  CLOUDFLARE_R2
  AWS_S3
  LOCAL
}

model MediaProviderConfig {
  id                         String            @id @default(cuid())
  provider                   MediaProviderType @default(BUNNY)
  environment                String            @default("production") // "production" | "development"
  isEnabled                  Boolean           @default(true)
  isProductionReady          Boolean           @default(false)
  
  // Encrypted Credentials (AES-256-GCM)
  accountApiKeyEncrypted     String?           @db.Text
  accountEmail               String?
  
  // Bunny Storage Zone
  storageZoneId              String?
  storageZoneName            String?
  storagePasswordEncrypted   String?           @db.Text
  storageHostname            String?           @default("storage.bunnycdn.com")
  
  // Bunny Pull Zone / CDN
  pullZoneId                 String?
  pullZoneName               String?
  cdnHostname                String?
  
  // Bunny Stream (Video Delivery)
  streamLibraryId            String?
  streamLibraryName          String?
  streamApiKeyEncrypted      String?           @db.Text
  
  // Token Authentication / Secure URL Signing
  tokenSecurityKeyEncrypted  String?           @db.Text
  enableTokenAuth            Boolean           @default(false)
  
  // Health & Verification
  lastTestedAt               DateTime?
  testResults                Json?             @db.JsonB
  metadata                   Json?             @db.JsonB
  
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([provider, environment])
  @@index([isEnabled, isProductionReady])
  @@map("media_provider_configs")
}

// ==========================================
// SUPPORT & INQUIRY SYSTEM
// ==========================================

enum SupportInquiryStatus {
  OPEN
  NEW
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

model SupportInquiry {
  id          String                  @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String                  @db.Text
  category    String                  @default("GENERAL")
  source      String                  @default("PUBLIC_CONTACT") // "PUBLIC_CONTACT" | "STUDENT_TICKET"
  status      SupportInquiryStatus    @default(OPEN)
  orderNumber String?
  adminNotes  String?                 @db.Text
  userId      String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  user        User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages    SupportInquiryMessage[]

  @@index([email])
  @@index([status])
  @@index([category])
  @@index([source])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("support_inquiries")
}

model SupportInquiryMessage {
  id          String         @id @default(cuid())
  inquiryId   String
  senderId    String?
  senderRole  String         // "STUDENT" | "ADMIN" | "GUEST"
  senderName  String
  message     String         @db.Text
  createdAt   DateTime       @default(now())

  inquiry     SupportInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([createdAt])
  @@map("support_inquiry_messages")
}

